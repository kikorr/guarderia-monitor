# ═════════════════════════════════════════════════════════════════════
#  Configuración del Monitor de la guardería
#  Copia este fichero como .env y rellena la parte IMPRESCINDIBLE.
#  Usuario, contraseña, token del bot, enlace del QR y DNI NO van aquí:
#  van en la carpeta secrets/ (ver README, paso 5).
# ═════════════════════════════════════════════════════════════════════

# ── IMPRESCINDIBLE ───────────────────────────────────────────────────
# Id del grupo (o chat) de Telegram donde llega todo. Los grupos empiezan por -100.
TG_CHAT_ID=-1001234567890

# Temas del grupo (solo si tiene «Temas» activados). Si no, déjalos vacíos.
TG_THREAD_MURO=
TG_THREAD_AGENDA=
TG_THREAD_SISTEMA=

# Zona horaria
TZ=Europe/Madrid

# ── FICHAJE DE ENTRADA (solo si has creado secrets/fichaje_url y secrets/fichaje_dni) ──
# Hora a la que pregunta si hay que fichar (HH:MM).
FICHAJE_HORA=09:00
# Días sin cole además de fines de semana y festivos nacionales (AAAA-MM-DD separados por comas).
FICHAJE_DIAS_CERRADO=

# ── OPCIONAL: quita la # y cambia el valor solo si lo necesitas ──────
# Avisos técnicos a otro grupo/chat (vacío = el mismo grupo).
#SISTEMA_CHAT_ID=-1009876543210
# Horario lectivo en que se revisan muro y agenda (horas enteras).
#WORK_HOUR_START=7
#WORK_HOUR_END=17
# Pasada nocturna del muro (hora). Vacío = desactivada.
#EVENING_MURO_HOUR=22
# Aviso si la agenda sigue vacía a esta hora en día lectivo. 0 = desactivado.
#AGENDA_EMPTY_ALERT_HOUR=15
# Seguir solo algunas aulas (expresión regular con parte del nombre). Vacío = todas.
#AULAS_INCLUDE=Bebés|Comunicados
# Días que se guardan las fotos/vídeos ya enviados.
#MEDIA_RETENTION_DAYS=30
# Mandar la agenda también a un segundo grupo/tema.
#TG_CHAT_ID_2=-1001112223334
#TG_THREAD_AGENDA_2=
# Portal de familias (el mismo para todos los centros).
#WL_LOGIN_URL=https://comunidaddefamilias.com

# Fichaje, ajustes finos (ver README, «Referencia técnica»).
#FICHAJE_CHAT_ID=
#FICHAJE_THREAD=
#FICHAJE_RECORDATORIO_MIN=30
#FICHAJE_COOKIES_EXTRA=nombre=valor
#FICHAJE_CENTRO=
#FICHAJE_STATE=/data/fichaje.json
#FICHAJE_DEBUG=1
#FICHAJE_HILO=0
# Bot aparte solo para el fichaje (lo normal es usar el mismo; ver README).
#FICHAJE_BOT_TOKEN_FILE=/run/secrets/fichaje_bot_token
