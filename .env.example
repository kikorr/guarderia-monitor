# ─────────────────────────────────────────────────────────────
#  Workandlife (portal de familias de la guardería)
# ─────────────────────────────────────────────────────────────
# Es lo ÚNICO obligatorio de la guardería: con tu usuario y contraseña,
# el monitor descubre solo el centro, las aulas de tu peque y su agenda.
# No hay que copiar ninguna URL: si cambia de aula o empieza curso nuevo,
# se entera él solo.
WL_USER=tu_usuario
WL_PASS=tu_contraseña

# ─────────────────────────────────────────────────────────────
#  Telegram
# ─────────────────────────────────────────────────────────────
# 1) Crea un bot con @BotFather y pega aquí su token.
TG_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Tu chat o grupo. Para sacarlo: manda un mensaje a tu bot y abre
#    https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#    El número en result[].message.chat.id es tu TG_CHAT_ID.
#    (Para un grupo el id suele ser negativo, p.ej. -1001234567890)
TG_CHAT_ID=123456789

# (OPCIONAL) Solo si usas un GRUPO con "Temas/Topics" activados y quieres
# separar muro/agenda/sistema en temas distintos. Déjalos VACÍOS para un chat normal.
TG_THREAD_MURO=
TG_THREAD_AGENDA=
TG_THREAD_SISTEMA=

# Zona horaria
TZ=Europe/Madrid

# (OPCIONAL) Pasada nocturna del muro todos los días a esta hora (24h) para
# pillar publicaciones de tardes/fines de semana. Por defecto 22. Vacío = desactivado.
EVENING_MURO_HOUR=22

# (OPCIONAL) Si quieres que las alertas/avisos del sistema vayan a un grupo DISTINTO
# del muro (p.ej. un grupo privado tuyo), pon aquí su chat_id. Vacío = mismo grupo.
SISTEMA_CHAT_ID=

# ─────────────────────────────────────────────────────────────
#  Opciones avanzadas (déjalas como están si no las necesitas)
# ─────────────────────────────────────────────────────────────
# Por defecto sigue TODAS las aulas que el portal te muestra (la de tu peque,
# "Comunicados de la Escuela", las de tarde…). Si solo quieres algunas, pon aquí
# una expresión regular que case con su nombre, p.ej.:  Cervatillo|Comunicados
AULAS_INCLUDE=

# Hora (24h) a partir de la cual, en día lectivo, te avisa si la agenda del día
# sigue COMPLETAMENTE vacía. Sirve para enterarte si la web cambia y deja de
# devolver datos, en vez de quedarte esperando en silencio. 0 = desactivado.
AGENDA_EMPTY_ALERT_HOUR=15

# Días que se conserva la caché local de fotos/vídeos ya enviados.
MEDIA_RETENTION_DAYS=30

# Enviar además la agenda a un segundo grupo/tema.
TG_CHAT_ID_2=
TG_THREAD_AGENDA_2=

# Punto de entrada del portal de familias. Es el mismo para todos los centros;
# solo tócalo si tu guardería usa otro.
WL_LOGIN_URL=https://comunidaddefamilias.com
