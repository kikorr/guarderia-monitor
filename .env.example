# ─────────────────────────────────────────────────────────────
#  Workandlife (portal de familias de la guardería)
# ─────────────────────────────────────────────────────────────
WL_USER=tu_usuario
WL_PASS=tu_contraseña

# URL del aula de tu peque. Entra al muro desde la web de Workandlife
# y copia la URL de la barra del navegador (algo como aula.php?sid=XXXX).
MURO_URL=https://TUCENTRO.workandlife.com/aulas/aula.php?sid=XXXX

# ─────────────────────────────────────────────────────────────
#  Telegram
# ─────────────────────────────────────────────────────────────
# 1) Crea un bot con @BotFather y pega aquí su token.
TG_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Tu chat o grupo. Para sacarlo: manda un mensaje a tu bot y abre
#    https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#    El número en result[].message.chat.id es tu TG_CHAT_ID.
#    (Para un grupo el id suele ser negativo, p.ej. -1001234567890)
TG_CHAT_ID=123456789

# (OPCIONAL) Solo si usas un GRUPO con "Temas/Topics" activados y quieres
# separar muro/agenda/sistema en temas distintos. Déjalos VACÍOS para un chat normal.
TG_THREAD_MURO=
TG_THREAD_AGENDA=
TG_THREAD_SISTEMA=

# Zona horaria
TZ=Europe/Madrid

# (OPCIONAL) Pasada nocturna del muro todos los días a esta hora (24h) para
# pillar publicaciones de tardes/fines de semana. Por defecto 22. Vacío = desactivado.
EVENING_MURO_HOUR=22

# (OPCIONAL) Si quieres que las alertas/avisos del sistema vayan a un grupo DISTINTO
# del muro (p.ej. un grupo privado tuyo), pon aquí su chat_id. Vacío = mismo grupo.
SISTEMA_CHAT_ID=
